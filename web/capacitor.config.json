{
  "appId": "com.omnisalon.barbershop",
  "appName": "Omni Salon",
  "webDir": ".",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#f1f3f6",
      "showSpinner": true,
      "spinnerColor": "#b48312"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f1f3f6"
    }
  }
}


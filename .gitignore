# OmniSalon Enterprise .gitignore

# Environment & Secret files
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Dependency directories
node_modules/
jspm_packages/

# Production builds & artifacts
dist/
build/
out/
.cache/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
test_theme_out.txt

# External cloned repositories (Ponytail / Caveman sources)
repos/

# Test suites, local QA benchmarks & test run artifacts
tests/

# IDE and Editor directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

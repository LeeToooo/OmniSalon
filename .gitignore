# OmniSalon Enterprise .gitignore

# Environment & Secret files (Chứa thông tin cá nhân & mật khẩu)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
email_config.json
email_config.*.json
!email_config.example.json
ai_config.json
ai_config.*.json
!ai_config.example.json
web/backend/ai_config.json

# Internal agent configurations & metadata
.agents/
.antigravity/
.taste-skill/
AGENTS.md

# Documentation & internal project docs
docs/
LUONG_XU_LY_HE_THONG.md
GIAI_THICH_CHI_TIET_LUONG_XU_LY.md

# Test suites, local QA benchmarks & test run artifacts
tests/
test_evidence/
e2e_*
functional_test_*
test_*.js

# External cloned repositories (Ponytail / Caveman sources)
repos/

# Dependency directories
node_modules/
jspm_packages/

# Flutter & Dart build cache & tooling
.dart_tool/
mobile/.dart_tool/
.packages
.pub/
.flutter-plugins
.flutter-plugins-dependencies

# Production builds & artifacts
dist/
build/
out/
.cache/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
test_theme_out.txt

# IDE and Editor directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Office & binary documents
*.docx
*.doc

# Python Cache
__pycache__/
*.py[cod]
